.filter-block { margin-bottom: 10px; }

.filter-primary {
  display: flex;
  box-sizing: border-box;
  align-items: stretch;
  gap: 8px;
}

/* picker 是 flex 项，必须能收缩，否则长标签会把「筛选」按钮挤出屏幕 */
.filter-picker { flex: 1 1 0; min-width: 0; }

.filter-picker__value {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 40px;
  padding: 0 10px;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-control);
  background: var(--surface);
  font-size: 13px;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.filter-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: 0 0 auto;
  padding: 0 12px;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-control);
  background: var(--surface);
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
}

.filter-toggle.is-active { border-color: var(--ink); background: var(--yellow); }

.filter-more {
  box-sizing: border-box;
  margin-top: 10px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius-control);
  background: var(--surface-subtle);
}

.filter-field {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}

.filter-field__label {
  flex: 0 0 66px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
}

.filter-field picker { flex: 1 1 0; min-width: 0; }
