/*
 * 宿主节点显式成块：列表交错入场动画挂在宿主上（页面把 .enter-rise 加在组件标签上），
 * transform 对非替换行内元素不生效，必须保证宿主是块级盒子；视觉上与原来一致。
 */
:host { display: block; }

.location-card {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--line);
  background: var(--surface);
}

.location-card.is-active { background: var(--yellow-soft); }

.location-card__main {
  display: flex;
  flex: 1;
  min-width: 0;
  gap: 10px;
}

.location-card__copy { flex: 1; min-width: 0; }

.location-card__name {
  display: block;
  font-size: 15px;
  font-weight: 700;
  word-break: break-all;
}

.location-card__address {
  display: block;
  margin-top: 2px;
  color: var(--muted);
  font-size: 12px;
  word-break: break-all;
}

.location-card__meta {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  margin-top: 6px;
  color: var(--subtle);
  font-size: 11px;
}

.location-card__category { flex: 0 0 auto; color: var(--muted); font-weight: 700; }
.location-card__by { min-width: 0; color: var(--subtle); word-break: break-all; }

.location-card__more {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: 0 0 auto;
  min-width: 32px;
  min-height: 32px;
  padding: 0 4px;
  color: var(--muted);
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 1px;
}
