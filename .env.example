# Supabase 共享空间（前端公开配置）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase 服务端配置（仅 Vercel Serverless 使用）
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 未设置 SUPABASE_SECRET_KEY 时回落到此变量
SUPABASE_SERVICE_ROLE_KEY=
RONGMAP_DEFAULT_MEMBER_PASSWORD=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_NAME=
RONGMAP_DEFAULT_SPACE_ID=
# 缺省空间名，迁移脚本未设置 RONGMAP_DEFAULT_SPACE_NAME 时使用
RONGMAP_DEFAULT_SPACE_NAME=

# 仅用于明确的本地旧版兼容调试；共享版生产环境保持关闭
RONGMAP_LEGACY_MODE=0

# Vercel KV 兼容存储（迁移窗口内保留）
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 设为 0 时不回源预发环境，改读本地 KV 或 data/locations.local.json
RONGMAP_REMOTE_FIRST=
# 指定回源的 Vercel 部署；留空时自动取该项目最新 Ready 部署
RONGMAP_REMOTE_DEPLOYMENT_URL=
# backup:kv 使用的部署地址；留空时自动解析
BACKUP_DEPLOYMENT_URL=
# 迁移与重置脚本读取的环境文件；缺省为 .env.local
ENV_FILE=.env.local

# 高德地图配置；请在高德控制台限制允许域名，并定期轮换
# 仓库不再存放任何真实密钥；未配置时地图和地点搜索会直接报错并提示缺哪个变量
VITE_AMAP_WEB_KEY=
VITE_AMAP_SECURITY_CODE=
AMAP_WEB_SERVICE_KEY=

# AI 旅行攻略规划（密钥仅放服务端，不使用 VITE_ 前缀）
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# 可选旅行情报 MCP（地址由服务端配置，不接受前端提交）
# 本地可用 http://127.0.0.1:18060/mcp 和 http://127.0.0.1:8001/mcp；留空则明确显示未接入。
# Vercel 的 localhost 指向云端容器，无法访问 Mac，需部署可访问且受认证保护的服务。
# 登录态由 MCP 服务在其本机持有；以下 Token 仅用于认证服务网关，不是小红书/点评 Cookie。
XHS_MCP_URL=
XHS_MCP_TOKEN=
CN_SCRAPER_URL=
CN_SCRAPER_TOKEN=
